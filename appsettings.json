{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(local);Database=Cliniq_dev;User Id=cliniq_user;Password=change-me;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "change-me-development-jwt-key-at-least-32-characters",
    "Issuer": "Cliniq",
    "Audience": "CliniqUsers",
    "ExpiryMinutes": 60
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "Cliniq_"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}
